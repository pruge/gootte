#!/usr/bin/env bash
# bin/gootte — TS CLI(`code/web/cli`)의 얇은 런처. 시간·상태 기록은 레코드(`state.json` v2) 전용이다.
#
#   gootte start [--at <TIME>] [--force] <feature-slug> <ticket>
#   gootte end [--at <TIME>] <feature-slug> <ticket>
#   gootte pause|resume|reset|cancel|drop [...] (같은 인자 규율)
#   gootte migrate [--dry-run] [--strip] <project-slug>
#   gootte memo|status|board|next|... (그대로 TS 에 전달)
#
# 🔴 MD(`Time:`/`Status:` 줄) 읽기·쓰기 코드는 제거됨(구관례 완전 정리) — 이 스크립트는
# 티켓 문서를 절대 건드리지 않고 TS 에 위임만 한다. 번역하는 것은 시간 동사 7개뿐이다.
#
# 실행 우선순위:
#   1) `$GOOTTE_HOME/code/web/cli/dist/gootte.cjs` 가 있으면 `node` 로 직접 실행한다.
#      npx/tsx/체크아웃 원본이 없어도 돈다 — GUI PATH·오프라인·타 기계(npm 설치본) 공통 경로다.
#   2) 없으면(dev 체크아웃) `npx tsx src/main.ts` 폴백 — npx 가 없으면 실패로 죽는다.
#
# GOOTTE_HOME 을 환경으로 고정할 수 있다(기본: 이 스크립트가 사는 저장소 루트 — 심링크·
# gootte worktree 해소 포함). npm 으로 설치한 `gootte` 바이너리는 dist 번들 그 자체라
# 이 스크립트를 거치지 않는다.

set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$TARGET" ;;
  esac
done
if [ -z "${GOOTTE_HOME:-}" ]; then
  GOOTTE_HOME="$(cd "$(dirname "$SELF")/.." && pwd)"
  # 🔴 GOOTTE_HOME 자신이 gootte 저장소의 **worktree** 면(그 안의 bin/gootte 는 실파일)
  # node_modules·미커밋 코드가 없다 — .git gitdir 에서 메인 gootte 저장소로 승격한다.
  if grep -q '^gitdir: ' "$GOOTTE_HOME/.git" 2>/dev/null; then
    MAIN_OF_TOOL="$(sed -n 's|^gitdir: \(.*\)/\.git/worktrees/.*|\1|p' "$GOOTTE_HOME/.git" | head -1)"
    [ -n "$MAIN_OF_TOOL" ] && GOOTTE_HOME="$MAIN_OF_TOOL"
  fi
fi

usage() {
  echo "사용법: gootte start [--at <TIME>] [--force] <feature-slug> <ticket>" >&2
  echo "      gootte end|pause|resume|reset|cancel|drop [--at <TIME>] <feature-slug> <ticket>" >&2
  echo "      gootte migrate [--dry-run] [--strip] <project-slug>" >&2
  echo "      gootte memo|status|board|next|... (그대로 전달)" >&2
  echo "  TIME: 비우면 지금 / ISO8601 / 상대시간(예 1h30m, 90m, 2h, 1d)" >&2
  echo "  --force: start 는 묻지 않고 새 시작으로 덮어씀. --update/-u 는 별칭" >&2
  echo "  기록 위치: <프로젝트>/.gootte/state.json (v2 레코드) — 문서는 건드리지 않는다." >&2
  exit 1
}

# 실행 위치 기준 프로젝트 루트를 찾는다: git 루트가 있으면 그것, 없으면 cwd.
# status/state 의 GOOTTE_ROOTS 기본값에만 쓴다.
resolve_root() {
  local git_root
  if git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    printf '%s\n' "$git_root"
  else
    pwd
  fi
}

main() {
  if [ "$#" -lt 1 ]; then
    usage
  fi
  case "${1:-}" in
    --help|-h) usage ;;
  esac

  command -v node &>/dev/null || { echo "gootte: node 가 필요합니다(PATH 확인)" >&2; exit 1; }

  local bundle="$GOOTTE_HOME/code/web/cli/dist/gootte.cjs"
  local ts_src="$GOOTTE_HOME/code/web/cli/src/main.ts"

  # 시간 동사 7개만 `time` 하위 명령으로 번역한다. --at/--force 는 TS 가 위치인자
  # 뒤에서 받으므로 뒤로 보낸다(옛 bash 파서와 같은 규약). 그 외 명령은 verbatim 전달 —
  # 거부·사용법 판정은 TS 몫이다(셸에서 삼키면 필터가 조용히 사라진다).
  local -a args=()
  case "$1" in
    start|pause|resume|end|reset|cancel|drop)
      local subcmd="$1"
      shift
      local at=""
      local force=0
      local -a pos=()
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --at)
            [ "$#" -ge 2 ] || { echo "gootte: --at 에 시간이 필요합니다" >&2; exit 1; }
            at="$2"; shift 2 ;;
          --at=*) at="${1#--at=}"; shift ;;
          --force|--update|-u) force=1; shift ;;
          *) pos+=("$1"); shift ;;
        esac
      done
      [ "${#pos[@]}" -ge 2 ] || usage
      args=(time "$subcmd" "${pos[@]}")
      [ -n "$at" ] && args+=(--at "$at")
      [ "$force" = "1" ] && args+=(--force)
      ;;
    status|state)
      # 현황 통합 — GOOTTE_ROOTS 기본값(옛 규약 유지)만 셸이 채우고 나머지는 그대로 넘긴다.
      if [ -z "${GOOTTE_ROOTS:-}" ]; then
        GOOTTE_ROOTS="$(dirname "$(resolve_root)")"
        export GOOTTE_ROOTS
      fi
      args=("$@")
      ;;
    *)
      args=("$@")
      ;;
  esac

  if [ -f "$bundle" ]; then
    exec node "$bundle" "${args[@]}"
  fi
  # dev 폴백 — 체크아웃 원본으로 돈다. npx 가 없으면 실패로 죽는다(MD 폴백은 없다).
  [ -f "$ts_src" ] || { echo "gootte: 도구 코드를 찾을 수 없습니다: $GOOTTE_HOME (GOOTTE_HOME 확인 또는 dist 빌드)" >&2; exit 1; }
  command -v npx &>/dev/null || { echo "gootte: dist 번들이 없고 npx 도 찾을 수 없습니다 — MD에 기록하지 않고 중단합니다(PATH 확인 또는 pnpm --filter @gootte/cli build)" >&2; exit 1; }
  exec npx --yes tsx "$ts_src" "${args[@]}"
}

main "$@"
