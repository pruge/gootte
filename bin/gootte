#!/usr/bin/env bash
# bin/gootte — 독립 bash CLI. gootte TS 모노레포의 워크스페이스 패키지를 전혀 참조하지 않는다.
#
# gootte start [--at <TIME>] <feature-slug> <ticket>   # 티켓 문서에 Time: started=<ISO> 삽입
# gootte end   [--at <TIME>] <feature-slug> <ticket>   # 같은 줄에 finished=<ISO> 추가
# gootte drop  [--at <TIME>] <feature-slug> [<ticket>] # Status: 줄을 wontfix (<날짜>) 로 갱신(폐기)
#                                                   티켓 생략 시 그 기능의 티켓 전부를 폐기
#
#   TIME: 비우면 지금. ISO8601(예 2026-08-29T15:00:00+09:00) 또는 상대시간
#         (예 1h30m, 90m, 2h, 1d, 1h30m ago) — "지금으로부터 뒤" 로 푼다.
#
# md 파일만 cat/sed/grep/awk 로 직접 읽고 쓴다. 커밋은 하지 않는다(grill D3).
#
# 이 스크립트가 찾는 경로는 실행 위치(cwd) 기준이다 — <프로젝트> 인자는 받지 않는다.
# git 루트가 있으면 그 루트, 없으면 cwd 를 기준으로 티켓을 찾는다. 두 관례를 본다:
#   - 신관례: docs/features/<feature-slug>/tickets/T<NN>.md  (Time: 줄 기록)
#   - 구관례: docs/features/<feature-slug>/issues/<NN>-*.md  (**Time:** 줄 기록)
# drop 은 두 관례 모두에서 Status: 줄을 갱신한다(구관례는 **Status:**).

set -euo pipefail

usage() {
  echo "사용법: gootte start [--at <TIME>] <feature-slug> <ticket>" >&2
  echo "      gootte end   [--at <TIME>] <feature-slug> <ticket>" >&2
  echo "      gootte drop  [--at <TIME>] <feature-slug> <ticket>" >&2
  echo "  TIME: 비우면 지금 / ISO8601 / 상대시간(예 1h30m, 90m, 2h, 1d)" >&2
  exit 1
}

# 실행 위치 기준 프로젝트 루트를 찾는다: git 루트가 있으면 그것, 없으면 cwd.
resolve_root() {
  local git_root
  if git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    printf '%s\n' "$git_root"
  else
    pwd
  fi
}

# "T01" 또는 "01" 을 "T01" 로 정규화한다.
normalize_ticket() {
  local raw="$1"
  local num="${raw#T}"
  num="${num#t}"
  if ! [[ "$num" =~ ^[0-9]+$ ]]; then
    echo "gootte: 티켓 번호가 잘못됐습니다: $raw" >&2
    exit 1
  fi
  printf 'T%02d' "$num"
}

# epoch 초를 ISO 8601(콜론 포함 오프셋)으로 낸다: 2026-08-29T10:30:00+09:00
fmt_epoch() {
  local raw
  raw="$(date -r "$1" +%Y-%m-%dT%H:%M:%S%z)"
  # %z 는 +0900 형태 — 마지막 두 자리 앞에 콜론을 넣어 +09:00 으로 만든다.
  printf '%s%s:%s\n' "${raw:0:19}" "${raw:19:3}" "${raw:22:2}"
}

# "1h30m" / "90m" / "2h" / "3d" / "45m" / "30s" 형태의 상대 시간을 지금으로부터 뺀 epoch 초로 푼다.
# 선택: 뒤에 " ago" 가 붙거나 앞에 "-" 가 붙어도 같게 본다. 소수는 지원하지 않는다(정수 단위만).
parse_relative() {
  local spec="$1"
  spec="${spec,,}"          # 소문자
  spec="${spec% ago}"       # 뒤 " ago" 제거
  spec="${spec#-}"          # 앞 "-" 제거
  local total=0 rest="$spec" num unit
  if [ -z "$rest" ]; then
    echo "gootte: 시간 표현이 비어있습니다: $1" >&2
    return 1
  fi
  while [[ "$rest" =~ ^([0-9]+)([smhd])(.*)$ ]]; do
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"
    case "$unit" in
      s) total=$((total + num)) ;;
      m) total=$((total + num * 60)) ;;
      h) total=$((total + num * 3600)) ;;
      d) total=$((total + num * 86400)) ;;
    esac
  done
  if [ -n "$rest" ]; then
    echo "gootte: 이해 못한 시간 표현: $1 (예: 1h30m, 90m, 2h, 1d)" >&2
    return 1
  fi
  local now_ep
  now_ep="$(date +%s)"
  echo $((now_ep - total))
}

# TIME 인자를 시각으로 풀는다 — 비면 지금, 'T' 가 들어가면 ISO8601 그대로, 그 외엔 상대 시간.
resolve_time() {
  local arg="${1:-}"
  if [ -z "$arg" ]; then
    fmt_epoch "$(date +%s)"
    return
  fi
  if [[ "$arg" == *T* ]]; then
    printf '%s\n' "$arg"
    return
  fi
  local ep
  if ! ep="$(parse_relative "$arg")"; then
    return 1
  fi
  fmt_epoch "$ep"
}

# drop 이 기록할 폐기일 — `YYYY-MM-DD HH:MM`(triage-labels 의 resolved 와 평행한 현지 시각).
# 비면 지금, ISO8601 은 오프셋 콜론을 벗겨 epoch 로, 그 외엔 상대시간으로 푼다.
resolve_drop_date() {
  local arg="${1:-}"
  local ep
  if [ -z "$arg" ]; then
    ep="$(date +%s)"
  elif [[ "$arg" == *T* ]]; then
    local iso="${arg/%:00/00}"   # +09:00 → +0900 (BSD date 가 원함)
    ep="$(date -j -f "%Y-%m-%dT%H:%M:%S%z" "$iso" "+%s" 2>/dev/null)" \
      || ep="$(date +%s)"
  else
    ep="$(parse_relative "$arg")" || ep="$(date +%s)"
  fi
  date -r "$ep" +"%Y-%m-%d %H:%M"
}

resolve_ticket_file() {
  local feature_slug="$1"
  local ticket_norm="$2"
  local root
  root="$(resolve_root)"
  # 신관례: tickets/T<NN>.md
  local tickets_file="$root/docs/features/$feature_slug/tickets/$ticket_norm.md"
  if [ -f "$tickets_file" ]; then
    printf '%s\n' "$tickets_file"
    return
  fi
  # 구관례: issues/<NN>-*.md (번호만 쓴다 — 파일명은 T 접두가 없다)
  local num="${ticket_norm#T}"
  local issues_file
  issues_file="$(ls "$root"/docs/features/"$feature_slug"/issues/"$num"-*.md 2>/dev/null | head -1)"
  if [ -n "$issues_file" ] && [ -f "$issues_file" ]; then
    printf '%s\n' "$issues_file"
    return
  fi
  echo "gootte: 티켓 파일을 찾을 수 없습니다:" >&2
  echo "  신관례: $tickets_file" >&2
  echo "  구관례: $root/docs/features/$feature_slug/issues/${num}-*.md" >&2
  exit 1
}

# 파일에서 "Time:" / "**Time:**" 줄 번호를 찾는다(없으면 아무것도 출력하지 않는다).
find_time_line_no() {
  local file="$1"
  grep -niE '^\*{0,2}time:' "$file" | head -1 | cut -d: -f1 || true
}

# 제목 뒤, 본문 앞의 메타데이터 블록(연속된 Status:/Time: 줄) 마지막 줄 번호를 찾는다.
# 그 블록이 없으면 제목 줄 번호를 돌려준다.
find_header_block_end_line_no() {
  local file="$1"
  local title_line
  title_line="$(grep -n '^# ' "$file" | head -1 | cut -d: -f1)"
  if [ -z "$title_line" ]; then
    echo "gootte: 티켓 파일에 제목(# ...) 줄이 없습니다: $file" >&2
    exit 1
  fi
  local total_lines
  total_lines="$(wc -l < "$file" | tr -d ' ')"
  # 빈 줄은 건너뛰고, Status:/Time: 줄만 블록의 일부로 센다. 그 외 내용을 만나면 멈춘다.
  # (실물 티켓은 보통 제목 뒤에 빈 줄 → Status: → 빈 줄 → 본문 순서다.)
  local last="$title_line"
  local i=$((title_line + 1))
  while [ "$i" -le "$total_lines" ]; do
    local content
    content="$(sed -n "${i}p" "$file")"
    case "$content" in
      # 메타데이터 키 줄만 블록 연장 — 임의의 `**` 굵은 줄은 안 됨(`**What to build:**` 처럼
      # 산문 문단이 `**` 로 줄을 이을 수 있어서). 빈 줄은 건너뛰되 last 는 갱신하지 않는다.
      Status:*|Time:*|Blocked\ by:*|\*\*Status:*|**Time:*|**Blocked\ by:*|\*\*Needs\ Captain\ Eye:*)
        last="$i"
        i=$((i + 1))
        ;;
      '')
        i=$((i + 1))
        ;;
      *)
        break
        ;;
    esac
  done
  printf '%s\n' "$last"
}

cmd_start() {
  local at="$1"
  local feature_slug="$2"
  local ticket_raw="$3"
  local ticket_norm
  ticket_norm="$(normalize_ticket "$ticket_raw")"
  local file
  file="$(resolve_ticket_file "$feature_slug" "$ticket_norm")"

  local existing_line_no
  existing_line_no="$(find_time_line_no "$file")"
  if [ -n "$existing_line_no" ]; then
    echo "gootte: 이미 시작된 티켓입니다(Time: 줄이 이미 있음): $file" >&2
    exit 1
  fi

  local insert_after
  insert_after="$(find_header_block_end_line_no "$file")"
  local iso
  iso="$(resolve_time "$at")" || exit 1

  # 구관례(issues/)는 굵은 **Time:** 표기를 쓴다 — 신관례(tickets/)는 Time:.
  local time_label="Time:"
  [[ "$file" == */issues/* ]] && time_label="**Time:**"

  local tmp
  tmp="$(mktemp)"
  awk -v n="$insert_after" -v line="$time_label started=$iso" '
    { print }
    NR == n { print line }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"

  echo "gootte: $file 에 $time_label started=$iso 기록됨"
}

cmd_end() {
  local at="$1"
  local feature_slug="$2"
  local ticket_raw="$3"
  local ticket_norm
  ticket_norm="$(normalize_ticket "$ticket_raw")"
  local file
  file="$(resolve_ticket_file "$feature_slug" "$ticket_norm")"

  local existing_line_no
  existing_line_no="$(find_time_line_no "$file")"
  if [ -z "$existing_line_no" ]; then
    echo "gootte: 시작되지 않은 티켓입니다(Time: 줄이 없음): $file" >&2
    exit 1
  fi

  local existing_line
  existing_line="$(sed -n "${existing_line_no}p" "$file")"
  if printf '%s' "$existing_line" | grep -q 'finished='; then
    echo "gootte: 이미 끝난 티켓입니다(finished= 가 이미 있음): $file" >&2
    exit 1
  fi

  local iso
  iso="$(resolve_time "$at")" || exit 1
  local new_line="$existing_line finished=$iso"

  local tmp
  tmp="$(mktemp)"
  awk -v n="$existing_line_no" -v line="$new_line" '
    NR == n { print line; next }
    { print }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"

  # 🔴 구관례(issues/) 티켓만 — `end` = 완료이므로 `**Status:**` 줄을 `resolved (완료일)` 로 갱신한다
  # (ready-for-agent 등으로 남아 있던 것이 그대로 방치되는 것을 막는다). 이미 resolved 면 건너뛴다.
  # 신관례(tickets/) 는 done 을 Time: 줄에서 파생하므로 여기서 Status: 를 쓰지 않는다(drop 만 쓴다).
  if [[ "$file" == */issues/* ]]; then
    local status_line_no
    status_line_no="$(grep -niE '^\*{0,2}status:' "$file" | head -1 | cut -d: -f1 || true)"
    if [ -n "$status_line_no" ]; then
      local cur_status
      cur_status="$(sed -n "${status_line_no}p" "$file")"
      if ! printf '%s' "$cur_status" | grep -qi 'resolved'; then
        local done_date
        done_date="$(resolve_drop_date "$at")" || done_date="$(date +%Y-%m-%d\ %H:%M)"
        local tmp2
        tmp2="$(mktemp)"
        awk -v n="$status_line_no" -v d="$done_date" \
          'NR == n { print "**Status:** resolved (" d ")"; next } { print }' "$file" > "$tmp2"
        mv "$tmp2" "$file"
        echo "gootte: $file 의 **Status:** 를 resolved ($done_date) 로 갱신함"
      fi
    fi
  fi

  echo "gootte: $file 에 finished=$iso 기록됨"
}

# 한 티켓 파일 하나를 폐기 — Status: 줄을 `wontfix (<날짜>)` 로 갱신(문서가 SoT, gootte 는 dropped 로 읽음).
# 반환: 0 = 갱신함, 1 = 이미 wontfix 라 건너뜀.
drop_file() {
  local file="$1" drop_date="$2"
  local existing_line_no
  existing_line_no="$(grep -niE '^\*{0,2}status:' "$file" | head -1 | cut -d: -f1 || true)"
  if [ -n "$existing_line_no" ]; then
    local existing_line
    existing_line="$(sed -n "${existing_line_no}p" "$file")"
    if printf '%s' "$existing_line" | grep -qiE 'wontfix'; then
      echo "gootte: 이미 폐기됨(건너뜀): $file" >&2
      return 1
    fi
  fi
  # 구관례(issues/)는 굵은 **Status:**, 신관례(tickets/)는 Status: — 단 기존 줄이 있으면 그 bold 를 따른다.
  local status_label="Status:"
  [[ "$file" == */issues/* ]] && status_label="**Status:**"
  local new_line="$status_label wontfix ($drop_date)"
  if [ -n "$existing_line_no" ] && printf '%s' "$existing_line" | grep -qiE '^\*\*status:'; then
    new_line="**Status:** wontfix ($drop_date)"
  fi
  local tmp
  tmp="$(mktemp)"
  if [ -n "$existing_line_no" ]; then
    awk -v n="$existing_line_no" -v line="$new_line" 'NR == n { print line; next } { print }' "$file" > "$tmp"
  else
    local insert_after
    insert_after="$(find_header_block_end_line_no "$file")"
    awk -v n="$insert_after" -v line="$new_line" '{ print } NR == n { print line }' "$file" > "$tmp"
  fi
  mv "$tmp" "$file"
  echo "gootte: $file 에 $new_line 기록됨"
  return 0
}

# 한 기능 폴더의 모든 티켓 파일 경로(구관례 issues/<NN>-*.md + 신관례 tickets/T<NN>.md)를 줄별로 출력.
list_feature_tickets() {
  local root="$1" feature_slug="$2"
  local dir="$root/docs/features/$feature_slug"
  [ -d "$dir" ] || return 0
  local f
  shopt -s nullglob
  for f in "$dir"/issues/[0-9]*-*.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
  for f in "$dir"/tickets/T[0-9]*.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
  shopt -u nullglob
}

# 티켓 하나 또는 기능 전체를 폐기한다.
#   gootte drop <기능> <티켓>  → 한 티켓
#   gootte drop <기능>         → 그 기능의 티켓 전부(issues/ + tickets/)
cmd_drop() {
  local at="$1"
  local feature_slug="$2"
  local ticket_raw="${3:-}"
  local ticket_norm=""
  [ -n "$ticket_raw" ] && ticket_norm="$(normalize_ticket "$ticket_raw")"
  local drop_date
  drop_date="$(resolve_drop_date "$at")" || exit 1

  if [ -n "$ticket_raw" ]; then
    local file
    file="$(resolve_ticket_file "$feature_slug" "$ticket_norm")"
    drop_file "$file" "$drop_date"   # 이미 폐기됐으면 exit 1(단일 모드에선 에러)
  else
    local root
    root="$(resolve_root)"
    local dir="$root/docs/features/$feature_slug"
    if [ ! -d "$dir" ]; then
      echo "gootte: 기능을 찾을 수 없습니다: $dir" >&2
      exit 1
    fi
    local count=0 f
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if drop_file "$f" "$drop_date"; then count=$((count + 1)); fi
    done < <(list_feature_tickets "$root" "$feature_slug")
    echo "gootte: $feature_slug 기능의 티켓 $count 개를 폐기 처리함"
  fi
}

main() {
  if [ "$#" -lt 1 ]; then
    usage
  fi
  local at=""
  local -a pos=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --at)
        [ "$#" -ge 2 ] || { echo "gootte: --at 에 시간이 필요합니다" >&2; exit 1; }
        at="$2"; shift 2 ;;
      --at=*) at="${1#--at=}"; shift ;;
      --help|-h) usage ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [ "${#pos[@]}" -ge 2 ] || usage
  local subcmd="${pos[0]}"
  case "$subcmd" in
    start|end)
      [ "${#pos[@]}" -eq 3 ] || usage
      if [ "$subcmd" = "start" ]; then cmd_start "$at" "${pos[1]}" "${pos[2]}"
      else cmd_end "$at" "${pos[1]}" "${pos[2]}"; fi ;;
    drop)
      [ "${#pos[@]}" -le 3 ] || usage
      cmd_drop "$at" "${pos[1]}" "${pos[2]:-}" ;;
    *) usage ;;
  esac
}

main "$@"
