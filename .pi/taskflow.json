{
  "workerBin": "worker",
  "gootteBin": "bin/gootte",
  "worktreeRoot": ".claude/worktrees",
  "base": "main",

  "agentKind": "pi",
  "piModel": "bai/qwen3.8-flash",
  "piThinking": "high",

  "verifyCmd": "pnpm run verify",
  "verifyTimeoutMs": 600000,
  "spawnTimeoutMs": 1800000,

  "relayBin": "relay",
  "workopsBin": "workops",

  "workerRequires": {
    "paths": ["scripts/lib/allocate-worktree-ports.sh"],
    "scripts": ["verify", "worktree:bootstrap", "db"]
  },

  "merge": {
    "autoLandPattern": "\\*\\*Auto-land:\\*\\*\\s*yes",
    "landMode": "prove"
  }
}
