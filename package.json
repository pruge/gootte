{
  "name": "gootte",
  "private": true,
  "bin": {
    "gootte": "bin/gootte"
  },
  "scripts": {
    "setup": "pnpm run setup:web && pnpm run setup:tauri",
    "setup:web": "pnpm -C code/web install",
    "setup:tauri": "bash scripts/tauri-setup.sh",
    "gootte": "bash scripts/gootte.sh",
    "discover": "bash scripts/gootte.sh discover",
    "db": "bash scripts/gootte.sh db",
    "verify": "pnpm run test:ports && pnpm -C code/web verify",
    "test": "pnpm -C code/web test",
    "test:ports": "bash scripts/tests/ports.test.sh && bash scripts/tests/gootte-wrapper.test.sh && bash scripts/tests/gootte-time.test.sh",
    "dev:backend": "bash scripts/dev-backend.sh",
    "dev:frontend": "bash scripts/dev-frontend.sh",
    "dev": "bash scripts/dev.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "dev:tauri": "bash scripts/tauri-dev.sh",
    "build:tauri": "bash scripts/tauri-build.sh",
    "install:tauri": "bash scripts/tauri-install.sh",
    "e2e": "pnpm -C code/web/frontend e2e"
  }
}
