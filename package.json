{
  "name": "gootte",
  "private": true,
  "scripts": {
    "setup": "pnpm -C code/web install",
    "gootte": "pnpm -s -C code/web gootte",
    "discover": "pnpm -s -C code/web gootte discover",
    "db": "pnpm -s -C code/web gootte db",
    "verify": "pnpm run test:ports && pnpm -C code/web verify",
    "test": "pnpm -C code/web test",
    "test:ports": "bash scripts/tests/ports.test.sh",
    "dev:backend": "bash scripts/dev-backend.sh",
    "dev:frontend": "bash scripts/dev-frontend.sh",
    "dev": "bash scripts/dev.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "e2e": "pnpm -C code/web/frontend e2e"
  }
}
